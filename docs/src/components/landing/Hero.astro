---
import { linePath, results, totalRate } from './model.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const r = results();
const box = { x: 44, y: 18, w: 540, h: 200 };
const max = 3600;
const quota = linePath(r.aimd.history, (p) => p.limit, box, { step: 1, max });
const aimd = linePath(r.aimd.history, totalRate, box, { max });
const last = r.aimd.history.at(-1).t;
const throttles = r.aimd.history.filter((p) => p.n429 > 0).map((p) => box.x + (p.t / last) * box.w);
const yTicks = [0, 1000, 2000, 3000].map((v) => ({ v, y: box.y + box.h * (1 - v / max) }));
const xTicks = [0, 5, 10, 15].map((m) => ({ m, x: box.x + ((m * 60) / last) * box.w }));
const dropX = box.x + (300 / last) * box.w;
const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
const install = 'dotnet add package Nall.RateLimiting.Adaptive';
---

<section class="hero not-content">
	<div class="bg" aria-hidden="true"></div>
	<div class="copy">
		<a class="pill" href={`${base}/guide/playground/`}>
			<span class="tag">New</span> Try the rate limit simulator <span aria-hidden="true">→</span>
		</a>
		<h1>Find the rate the API allows. <span class="grad">Stay under it.</span></h1>
		<p class="sub">
			Adaptive client-side rate limiting for .NET <code>HttpClient</code>. The limiter slows down on
			<code>429</code>, honors <code>Retry-After</code>, and climbs back when the server allows it.
		</p>
		<div class="actions">
			<a class="btn primary" href={`${base}/guide/getting-started/`}>Get started</a>
			<a class="btn" href={`${base}/guide/how-it-works/`}>How it works</a>
		</div>
		<div class="install">
			<span class="prompt" aria-hidden="true">$</span>
			<code>{install}</code>
			<button type="button" class="copy-btn" data-copy={install} aria-label="Copy the install command">
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
			</button>
		</div>
		<ul class="meta">
			<li>.NET 8 and .NET 10</li>
			<li>AOT compatible</li>
			<li>IHttpClientFactory</li>
			<li>MIT</li>
		</ul>
	</div>

	<figure class="window">
		<div class="bar">
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<span class="title">orders-api · 2 instances · quota 3,000 units/min</span>
		</div>
		<svg viewBox="0 0 600 250" role="img" aria-labelledby="hero-chart-title">
			<title id="hero-chart-title">Limiter rate against the server quota over 15 minutes, model run</title>
			<defs>
				<linearGradient id="hero-fill" x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="var(--sl-color-accent)" stop-opacity="0.28"></stop>
					<stop offset="1" stop-color="var(--sl-color-accent)" stop-opacity="0"></stop>
				</linearGradient>
			</defs>
			{
				yTicks.map((t) => (
					<g>
						<line class="grid" x1={box.x} x2={box.x + box.w} y1={t.y} y2={t.y} />
						<text class="tick" x={box.x - 8} y={t.y + 4} text-anchor="end">
							{t.v ? `${t.v / 1000}k` : '0'}
						</text>
					</g>
				))
			}
			{
				xTicks.map((t) => (
					<text class="tick" x={t.x} y={box.y + box.h + 22} text-anchor="middle">
						{t.m} min
					</text>
				))
			}
			<path class="area" d={`${aimd}L${box.x + box.w} ${box.y + box.h}L${box.x} ${box.y + box.h}Z`}></path>
			<path class="quota" d={quota}></path>
			<path class="aimd draw" d={aimd} pathLength="1"></path>
			{throttles.map((x) => <line class="throttle" x1={x} x2={x} y1={box.y + box.h - 8} y2={box.y + box.h} />)}
			<text class="note" x={dropX + 6} y={box.y + box.h * (1 - 1500 / max) + 16}>quota drops 50% for 60 s</text>
		</svg>
		<div class="legend">
			<span><i class="k-aimd"></i>Limiter rate (AIMD)</span>
			<span><i class="k-quota"></i>Server quota</span>
			<span><i class="k-429"></i>429</span>
			<span class="model">Model run, seed 42</span>
		</div>
		<dl class="kpis">
			<div>
				<dt>Quota used</dt>
				<dd>{Math.round(r.aimd.share * 100)}%</dd>
			</div>
			<div>
				<dt>429s in 15 min</dt>
				<dd>{fmt(r.aimd.n429)} <small>vs {fmt(r.none.n429)} with retry only</small></dd>
			</div>
			<div>
				<dt>Recovery</dt>
				<dd>{r.aimd.recovery} s</dd>
			</div>
		</dl>
	</figure>
</section>

<script>
	for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-btn')) {
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy ?? '');
				btn.classList.add('done');
				setTimeout(() => btn.classList.remove('done'), 1500);
			} catch {}
		});
	}
</script>

<style>
	.hero {
		position: relative;
		display: grid;
		gap: 3rem;
		align-items: center;
		padding: 4rem 0 3rem;
	}
	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: 1fr 1.1fr;
			padding: 6rem 0 4rem;
		}
	}
	.bg {
		position: absolute;
		inset: -2rem calc(-1 * var(--sl-content-pad-x)) 0;
		z-index: -1;
		background-image:
			linear-gradient(var(--land-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--land-grid) 1px, transparent 1px);
		background-size: 40px 40px;
		mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
	}
	.bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(40rem 20rem at 70% 20%, color-mix(in srgb, var(--sl-color-accent) 14%, transparent), transparent 70%);
	}
	.copy {
		min-width: 0;
	}
	.pill {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.25rem 0.75rem 0.25rem 0.25rem;
		border: 1px solid var(--land-border);
		border-radius: 999px;
		background: var(--land-surface);
		color: var(--sl-color-gray-2);
		font-size: 0.8125rem;
		text-decoration: none;
	}
	.pill:hover {
		border-color: var(--sl-color-gray-4);
		color: var(--sl-color-white);
	}
	.pill .tag {
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 600;
		font-size: 0.75rem;
	}
	h1 {
		margin: 1.5rem 0 0;
		color: var(--sl-color-white);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
	}
	.grad {
		background: linear-gradient(90deg, var(--sl-color-accent), var(--land-series-2));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.sub {
		max-width: 34rem;
		margin: 1.25rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: 1.125rem;
		line-height: 1.6;
	}
	.sub code {
		padding: 0.05rem 0.3rem;
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-1);
		font-size: 0.9em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.btn {
		padding: 0.625rem 1.125rem;
		border: 1px solid var(--land-border);
		border-radius: 0.5rem;
		background: var(--land-surface);
		color: var(--sl-color-white);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
	}
	.btn:hover {
		border-color: var(--sl-color-gray-4);
	}
	.btn.primary {
		border-color: var(--sl-color-white);
		background: var(--sl-color-white);
		color: var(--sl-color-black);
	}
	.btn.primary:hover {
		opacity: 0.88;
	}
	.install {
		display: flex;
		gap: 0.625rem;
		align-items: center;
		max-width: 30rem;
		margin-top: 1.5rem;
		padding: 0.5rem 0.5rem 0.5rem 0.875rem;
		border: 1px solid var(--land-border);
		border-radius: 0.5rem;
		background: var(--land-surface-2);
		font-family: var(--__sl-font-mono);
		font-size: 0.8125rem;
	}
	.install code {
		flex: 1;
		overflow: hidden;
		color: var(--sl-color-gray-1);
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.prompt {
		color: var(--sl-color-accent);
	}
	.copy-btn {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	.copy-btn:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.copy-btn.done {
		color: var(--sl-color-accent);
	}
	.copy-btn svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--sl-color-gray-3);
		font-size: 0.8125rem;
	}
	.meta li::before {
		content: '✓ ';
		color: var(--sl-color-accent);
	}

	.window {
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--land-border);
		border-radius: 0.875rem;
		background: var(--land-surface);
		box-shadow:
			0 1px 0 hsla(0, 0%, 100%, 0.04) inset,
			0 24px 64px -24px hsla(240, 30%, 2%, 0.45);
	}
	.bar {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		padding: 0.625rem 0.875rem;
		border-bottom: 1px solid var(--land-border);
		background: var(--land-surface-2);
	}
	.dots {
		display: flex;
		gap: 0.375rem;
	}
	.dots i {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background: var(--sl-color-gray-5);
	}
	.bar .title {
		overflow: hidden;
		color: var(--sl-color-gray-3);
		font-family: var(--__sl-font-mono);
		font-size: 0.75rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.window svg {
		display: block;
		width: 100%;
		height: auto;
		padding: 0.75rem 0.5rem 0;
	}
	.grid {
		stroke: var(--land-border);
	}
	.tick {
		fill: var(--sl-color-gray-3);
		font-family: var(--__sl-font-mono);
		font-size: 12px;
	}
	.note {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
	}
	.area {
		fill: url(#hero-fill);
	}
	.quota {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-dasharray: 5 5;
		stroke-width: 1.5;
	}
	.aimd {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-linejoin: round;
		stroke-width: 2;
	}
	.throttle {
		stroke: var(--land-danger);
		stroke-width: 1.5;
	}
	.draw {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: draw 2.4s ease-out 0.2s forwards;
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.draw {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		padding: 0.25rem 1rem 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: 0.75rem;
	}
	.legend i {
		display: inline-block;
		width: 0.875rem;
		height: 0;
		margin-right: 0.375rem;
		vertical-align: middle;
		border-top: 2px solid;
	}
	.k-aimd {
		color: var(--sl-color-accent);
	}
	.k-quota {
		border-top-style: dashed !important;
		color: var(--sl-color-gray-2);
	}
	.k-429 {
		width: 0 !important;
		height: 0.625rem !important;
		border-top: 0 !important;
		border-left: 2px solid var(--land-danger);
	}
	.legend .model {
		margin-left: auto;
		font-style: italic;
	}
	.kpis {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 0;
		border-top: 1px solid var(--land-border);
	}
	.kpis div {
		padding: 0.875rem 1rem;
	}
	.kpis div + div {
		border-left: 1px solid var(--land-border);
	}
	.kpis dt {
		color: var(--sl-color-gray-3);
		font-size: 0.75rem;
	}
	.kpis dd {
		margin: 0.25rem 0 0;
		color: var(--sl-color-white);
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.kpis small {
		display: block;
		color: var(--sl-color-gray-3);
		font-size: 0.6875rem;
		font-weight: 400;
		letter-spacing: 0;
	}
</style>
