{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AdaptiveRateLimiting": {
    "Limiters": {
      "quota-api": {
        "Controller": "Aimd",
        "InitialUnitsPerMinute": 900,
        "MinUnitsPerMinute": 300,
        "MaxUnitsPerMinute": 6000,
        "Aimd": {
          "DecreaseFactor": 0.7,
          "IncreaseStep": 360,
          "IncreaseInterval": "00:00:05"
        }
      }
    }
  }
}
