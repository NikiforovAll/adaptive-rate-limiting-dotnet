<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Nall.RateLimiting.Adaptive.MicrosoftGraph</PackageId>
    <Title>Nall.RateLimiting.Adaptive.MicrosoftGraph</Title>
    <Description>Adaptive rate limiting for Microsoft Graph and SharePoint Online: counts SharePoint resource units (RU) per request and per $batch, reads throttled inner $batch responses, and puts the limiter inside the Kiota retry handler.</Description>
    <PackageTags>ratelimiting;throttling;adaptive;microsoft-graph;sharepoint</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nall.RateLimiting.Adaptive\Nall.RateLimiting.Adaptive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nall.RateLimiting.Adaptive.MicrosoftGraph.Tests" />
  </ItemGroup>
</Project>
