<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Nall.RateLimiting.Adaptive</PackageId>
    <Title>Nall.RateLimiting.Adaptive</Title>
    <Description>Adaptive client-side rate limiting for HttpClient, with pluggable rate controllers (AIMD, CUBIC). Slows down on throttled responses, honors Retry-After, and shares a budget across processes.</Description>
    <PackageTags>ratelimiting;throttling;adaptive;aimd;cubic;httpclient;429;retry-after</PackageTags>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nall.RateLimiting.Adaptive.Tests" />
    <InternalsVisibleTo Include="Nall.RateLimiting.Adaptive.MicrosoftGraph.Tests" />
  </ItemGroup>
</Project>
